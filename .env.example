# Copie ce fichier en .env.local pour le développement (jamais commité).
# Voir CLAUDE.md pour la matrice complète par environnement Vercel.

# --- Base de données (Neon Postgres) — Phase 1 ------------------------------

# Chaîne de connexion "pooled" (via PgBouncer), utilisée par l'application au
# runtime (Server Actions, Route Handlers, requêtes Drizzle standards).
# Jamais exposée au client. Format : postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

# Chaîne de connexion directe (sans pooler), requise par drizzle-kit pour les
# migrations et le seed (le pooler ne supporte pas toutes les opérations DDL).
# Jamais exposée au client.
DATABASE_URL_UNPOOLED=

# --- Authentification (Better Auth) — Phase 2 --------------------------------

# Clé secrète utilisée pour signer les sessions et jetons. Générer avec :
# openssl rand -base64 32
# Jamais exposée au client. Ne JAMAIS réutiliser entre environnements.
BETTER_AUTH_SECRET=

# URL de base de l'application, utilisée par Better Auth pour construire les
# liens de callback, vérification d'email, reset de mot de passe.
# Dev : http://localhost:3000 — Prod/Preview : URL Vercel du déploiement.
# Jamais exposée au client (usage serveur uniquement pour la config auth).
BETTER_AUTH_URL=http://localhost:3000

# URL publique de l'application, utilisée côté client (liens de partage de
# devis/factures publics, redirections, emails). Doit avoir le préfixe
# NEXT_PUBLIC_ pour être accessible au bundle client — c'est voulu, cette
# valeur n'est pas un secret.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Emails transactionnels (Resend) — Phase 2+ ------------------------------

# Clé API Resend. Si absente : mode dégradé autorisé, les emails sont écrits
# dans la console et dans .mail/*.html au lieu d'être envoyés. Ne bloque
# aucune phase de développement.
# Jamais exposée au client.
RESEND_API_KEY=

# Adresse d'expédition vérifiée sur Resend (ex. "Argent Brut <no-reply@tondomaine.fr>").
# Utilisée aussi comme en-tête "De" dans le mode dégradé console/.mail/.
# Pas un secret à proprement parler, mais usage serveur uniquement.
RESEND_FROM_EMAIL=

# --- Stockage de fichiers (Vercel Blob) — Phase 7 ----------------------------

# Jeton d'accès Vercel Blob, utilisé uniquement en production/preview via
# l'interface lib/storage.ts. En développement local, storage.ts bascule
# automatiquement sur le système de fichiers local : cette variable n'est pas
# nécessaire pour développer en local.
# Jamais exposée au client.
BLOB_READ_WRITE_TOKEN=

# --- Tâches planifiées (Vercel Cron) — Phase 10 ------------------------------

# Secret partagé vérifié dans l'en-tête Authorization des routes appelées par
# Vercel Cron (rappels d'échéances, expiration des devis, facturation
# récurrente). Générer avec : openssl rand -base64 32
# Jamais exposée au client.
CRON_SECRET=
